# Copy to `.env` (gitignored) and fill in. Loaded by scripts/stacked_agents_poc.py.

# Anthropic API key for the AnthropicChatClient / native gateway path.
ANTHROPIC_API_KEY=

# Optional Ollama overrides (defaults work for a local install on port 11434).
# BAROQUE_LLM_BASE_URL=http://localhost:11434/v1
# BAROQUE_LLM_API_KEY=ollama

# Optional local model selection used by the Ollama integration test.
# BAROQUE_TEST_MODEL=gemma4:e2b
